# Copy to .env (gitignored). `make local-up` does this and fills in random values.

# Object store root credentials. Never leave these at RustFS's rustfsadmin default.
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me-too

# OpenSearch 2.12+ refuses to start without a strong admin password (upper, lower, digit,
# special, 8+ chars). Only read on first start with an empty volume.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me

# Password for the least-privilege `bedrock-kb` user that local_init.py creates. The worker and
# runtime use this user, never admin: the local version of the AOSS data-access policy.
BEDROCK_KB_PASSWORD=change-me
